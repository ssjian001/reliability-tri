      },
      "ApprovalCreate": {
        "properties": {
          "target_type": {
            "type": "string",
            "enum": [
              "rule_version",
              "curve"
            ],
            "title": "Target Type"
          },
          "target_id": {
            "type": "string",
            "title": "Target Id"
          },
          "action": {
            "type": "string",
            "enum": [
              "publish",
              "reject"
            ],
            "title": "Action"
          },
          "decision": {
            "type": "string",
            "enum": [
