                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Comment"
          }
        },
        "type": "object",
        "required": [
          "target_type",
          "target_id",
          "action",
          "decision"
        ],
        "title": "ApprovalCreate"
      },
      "CurveCreate": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Id"
          },
          "x_unit": {
            "type": "string",
            "title": "X Unit"
          },
          "y_unit": {
            "type": "string",
            "title": "Y Unit"
          },
          "z_unit": {
            "type": "string",
            "title": "Z Unit"
          },
          "x_values": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "X Values"
          },
          "y_values": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "Y Values"
          },
          "z_values": {
            "items": {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            "type": "array",
            "title": "Z Values"
          },
          "interpolation": {
            "type": "string",
            "enum": [
              "linear",
              "log_log_linear"
            ],
            "title": "Interpolation",
            "default": "log_log_linear"
          },
          "source_ref": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Source Ref"
          },
          "checksum": {
            "type": "string",
            "maxLength": 64,
            "minLength": 64,
            "title": "Checksum"
          }
        },
        "type": "object",
        "required": [
          "id",
          "x_unit",
          "y_unit",
          "z_unit",
          "x_values",
          "y_values",
          "z_values",
          "source_ref",
          "checksum"
        ],
        "title": "CurveCreate"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "RuleCreate": {
        "properties": {
          "definition": {
            "additionalProperties": true,
            "type": "object",
            "title": "Definition"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "definition"
        ],
        "title": "RuleCreate"
      },
      "RuleTestRequest": {
        "properties": {
