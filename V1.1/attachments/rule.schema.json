{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reliability.local/schemas/rule.schema.json",
  "title": "Reliability Rule Definition",
  "description": "AI电子硬件可靠性分析系统 - 规则定义机读 Schema。配套文档：02_可靠性规则与知识库规范 §2/§2.1。 V1.1-ER-r2：新增 rule_type 三分类（declarative_expr/lookup_curve/script_plugin）与对应执行配置。配套文档：02 §2.2、附件 rule_templates.yaml。",
  "type": "object",
  "required": [
    "rule_id",
    "domain",
    "title",
    "intent",
    "applicability",
    "inputs",
    "severity",
    "rationale",
    "recommendation",
    "evidence_level",
    "owner",
    "version",
    "status",
    "tests",
    "rule_type"
  ],
  "properties": {
    "rule_id": {
      "type": "string",
      "pattern": "^[A-Z]{2,8}(-[A-Z0-9]+)*-[0-9]{3}$",
      "description": "规则编号，格式 域-子域-序号，如 ELEC-CAP-DCBIAS-001"
    },
    "domain": {
      "type": "string",
      "enum": [
        "derating",
        "pcb_pcba",
        "power",
        "esd_emi",
        "thermal",
        "dfmea",
        "fa",
        "dvpr"
      ],
      "description": "规则域：8 技术域（derating/pcb_pcba/power/esd_emi/thermal/dfmea/fa/dvpr）；对抗/边界域 5 类（unit_anomaly 等）仅用于 benchmark.domain，规则不使用（复审 delta P2-3）"
    },
    "title": {
      "type": "string",
      "maxLength": 120
    },
    "intent": {
      "type": "string",
      "description": "规则意图的一句话人读说明"
    },
    "applicability": {
      "type": "object",
      "description": "适用范围；键为对象属性（如 component_category），值为匹配值或数组",
      "additionalProperties": {
        "type": [
          "string",
          "array",
          "number",
          "boolean"
        ]
      }
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "unit",
          "required"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "unit": {
            "type": "string",
            "description": "单位，须能在 unit_dictionary.yaml 中归一；无量纲用 dimensionless"
          },
          "required": {
            "type": "boolean"
          },
          "source": {
            "type": "string",
            "description": "输入来源受控枚举",
            "enum": [
              "ComponentStress",
              "Component.rated_params",
              "Component.datasheet_curves",
              "OperatingProfile",
              "Thresholds",
              "Manual",
              "Artifact"
            ]
          },
          "quantity_kind": {
            "type": "string",
            "enum": [
              "absolute",
              "delta"
            ],
            "description": "量性质：absolute=绝对量（温度归一到 K 带偏移），delta=差量（K 不带偏移）；仅温度类需要。默认 absolute"
          },
          "type": {
            "type": "string",
            "description": "值类型：number/string/boolean/enum/table（复审 P2-3：02 要求 inputs 含类型）"
          }
        }
      }
    },
    "preconditions": {
      "type": "array",
      "description": "前置条件数组：只读 inputs 的受限 DSL；不满足时按 on_fail 状态跳过",
      "items": {
        "type": "object",
        "required": [
          "expr"
        ],
        "properties": {
          "expr": {
            "type": "string"
          },
          "on_fail": {
            "type": "string",
            "enum": [
              "SKIPPED_PRECONDITION",
              "NOT_APPLICABLE",
              "DATA_GAP"
            ],
            "default": "SKIPPED_PRECONDITION"
          }
        }
      }
    },
    "thresholds": {
      "description": "阈值组；纯提示类规则（无数值判定）与 plugin 判定类可为 null",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "minProperties": 1,
          "description": "单值阈值",
          "additionalProperties": {
            "type": "object",
            "required": [
              "value",
              "unit",
              "source_ref"
            ],
            "properties": {
              "value": {
                "type": "number"
              },
              "unit": {
                "type": "string"
              },
              "source_ref": {
                "type": "string"
              },
              "applicability_note": {
                "type": "string"
              }
            }
          }
        },
        {
          "type": "object",
          "minProperties": 1,
          "description": "分档阈值组",
          "additionalProperties": {
            "type": "object",
            "required": [
              "variants",
              "source_ref"
            ],
            "properties": {
              "variants": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "condition",
                    "value",
                    "unit"
                  ],
                  "properties": {
                    "condition": {
                      "type": "string"
                    },
                    "value": {
                      "type": "number"
                    },
                    "unit": {
                      "type": "string"
                    }
                  }
                }
              },
              "source_ref": {
                "type": "string"
              },
              "applicability_note": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low",
        "info"
      ],
      "description": "critical/high 命中时触发人工复核（01 §7）"
    },
    "rationale": {
      "type": "string"
    },
    "recommendation": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "evidence_id",
          "level",
          "publisher",
          "title",
          "version_date",
          "locator"
        ],
        "properties": {
          "evidence_id": {
            "type": "string"
          },
          "level": {
            "type": "string",
            "enum": [
              "A",
              "B",
              "C",
              "D"
            ]
          },
          "publisher": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "version_date": {
            "type": "string",
            "format": "date"
          },
          "locator": {
            "type": "string",
            "description": "页码/章节/条款号"
          },
          "part_number": {
            "type": "string"
          },
          "test_condition": {
            "type": "string"
          },
          "sample_size": {
            "type": [
              "integer",
              "null"
            ]
          },
          "limitations": {
            "type": "string"
          },
          "checksum": {
            "type": "string"
          }
        }
      }
    },
    "evidence_level": {
      "type": "string",
      "enum": [
        "A",
        "A_or_B",
        "B",
        "B_or_C",
        "C",
        "D"
      ],
      "description": "本规则整体证据等级（最高依赖级）"
    },
    "owner": {
      "type": "string",
      "description": "领域 Owner"
    },
    "reviewer": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "in_review",
        "tested",
        "shadow",
        "published",
        "deprecated"
      ]
    },
    "effective_date": {
      "type": "string",
      "format": "date"
    },
    "expiry_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "description": "单测用例。发布（published）前须 ≥3 条且 kind 覆盖 normal/boundary/invalid（validate_assets 复核）；本 schema 仅要求 ≥1 条以便草稿期校验。",
      "items": {
        "type": "object",
        "required": [
          "name",
          "inputs"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "normal",
              "boundary",
              "invalid",
              "unit_conflict",
              "plugin_numeric"
            ]
          },
          "inputs": {
            "type": "object"
          },
          "expected_pass": {
            "type": "boolean",
            "description": "规则判定通过与否；与 expected 逻辑判定一致"
          },
          "expected_status": {
            "type": "string",
            "enum": [
              "PASS",
              "FAIL",
              "SKIPPED_PRECONDITION",
              "NOT_APPLICABLE",
              "DATA_GAP",
              "CONFLICT_UNRESOLVED",
              "ERROR"
            ],
            "description": "期望执行状态；SKIPPED_PRECONDITION=前置条件不满足跳过"
          },
          "expected_outputs": {
            "type": "object",
            "description": "script_plugin 期望输出值（逐 outputs_exposed 变量）"
          },
          "tolerance_rel": {
            "type": "number",
            "description": "数值相对误差容差，默认 0.001（挂钩 03 §5 浮点口径）"
          },
          "error_code": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "MISSING_INPUT",
              "INVALID_VALUE",
              "DIV_BY_ZERO",
              "DIMENSION_MISMATCH",
              "UNKNOWN_UNIT",
              "TEMPERATURE_SCALE_AMBIGUOUS",
              "CONFLICT_UNRESOLVED",
              null
            ],
            "description": "错误码；null=无错误（PASS/SKIPPED/NA 场景）"
          }
        }
      }
    },
    "computed_service": {
      "type": [
        "string",
        "null"
      ],
      "description": "需要模型计算（寿命公式等）时指向确定性计算服务名；此时 expression 只比较其输出与阈值"
    },
    "rule_type": {
      "type": "string",
      "enum": [
        "declarative_expr",
        "lookup_curve",
        "script_plugin"
      ],
      "description": "规则类型：declarative_expr=静态布尔/四则（DSL 流水线）；lookup_curve=二维曲线插值/包络（曲线插值引擎）；script_plugin=受控白名单计算插件。执行器见 01 §3.1，模板见 rule_templates.yaml"
    },
    "notes": {
      "type": "string",
      "description": "人读补充说明（preconditions 数组化后的人读语义）"
    },
    "expression": {
      "type": "string",
      "description": "受限 DSL（Python 语法子集），declarative_expr 必填。变量按 inputs 声明单位口径传入，字面量同口径可比（02 §2.1）。JSON 表示将 01 §5.3 的 expression_or_payload 包络展平为顶层字段。"
    },
    "curve_eval": {
      "description": "rule_type=lookup_curve 执行配置。v1：单族 1D 插值（table_columns 声明 x/y）；expression 为人读描述不执行。temp_var 仅温度折减时必填。",
      "type": "object",
      "required": [
        "interpolation",
        "table_columns",
        "target_var"
      ],
      "properties": {
        "interpolation": {
          "type": "string",
          "description": "如 log_log_linear"
        },
        "table_columns": {
          "type": "object",
          "required": [
            "x",
            "y"
          ],
          "properties": {
            "x": {
              "type": "string"
            },
            "y": {
              "type": "string"
            },
            "family": {
              "type": "string",
              "description": "V2 多族分组列"
            }
          }
        },
        "target_var": {
          "type": "string",
          "description": "判定目标变量（inputs 中）"
        },
        "temp_var": {
          "type": "string",
          "description": "温度折减变量（有 temp_derating 时必填）"
        },
        "temp_derating_delta_ref_c": {
          "type": [
            "number",
            "null"
          ]
        },
        "temp_derating_delta_max_c": {
          "type": [
            "number",
            "null"
          ]
        },
        "temp_derating_factor": {
          "type": "string",
          "description": "人读描述，v1 不执行"
        },
        "safety_margin_ratio": {
          "type": "number"
        },
        "curve_out_of_bounds": {
          "type": "string",
          "enum": [
            "error",
            "clamp"
          ]
        }
      }
    },
    "plugin_ref": {
      "type": "object",
      "required": [
        "module",
        "entry_func"
      ],
      "description": "script_plugin 受控插件引用；digest 必填并在注册表校验（复审 C-3）",
      "properties": {
        "module": {
          "type": "string"
        },
        "entry_func": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "description": "插件内容 sha256"
        },
        "verdict_expr": {
          "type": "string",
          "description": "判定表达式（DSL；可引用 outputs/inputs/params）"
        },
        "params": {
          "type": "object"
        }
      }
    },
    "outputs_exposed": {
      "type": "array",
      "description": "script_plugin 输出声明（逐项 unit/quantity_kind，复审 P1-7）",
      "items": {
        "type": "object",
        "required": [
          "name",
          "unit",
          "type"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "number",
              "string",
              "boolean"
            ]
          },
          "quantity_kind": {
            "type": "string",
            "enum": [
              "absolute",
              "delta"
            ]
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "rule_type": {
            "const": "declarative_expr"
          }
        }
      },
      "then": {
        "required": [
          "expression"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "rule_type": {
            "const": "lookup_curve"
          }
        }
      },
      "then": {
        "required": [
          "curve_eval"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "rule_type": {
            "const": "script_plugin"
          }
        }
      },
      "then": {
        "required": [
          "plugin_ref",
          "outputs_exposed"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "published"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "tests": {
            "minItems": 3
          }
        }
      }
    }
  ]
}
