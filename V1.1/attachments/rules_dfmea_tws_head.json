[
  {
    "rule_id": "DFMEA-TWS-HALL-001",
    "rule_type": "declarative_expr",
    "domain": "dfmea",
    "title": "TWS 仓盖霍尔状态监测审查",
    "intent": "检查 TWS 充电仓设计是否含开盖超时休眠策略（防 Hall 误判常亮耗电）",
    "applicability": {
      "component_category": "TWS_Case"
    },
    "inputs": [
      {
        "name": "hall_sleep_timeout_hours",
        "unit": "h",
        "required": true,
        "source": "Thresholds",
        "quantity_kind": "absolute"
      },
      {
        "name": "min_required_hours",
        "unit": "h",
        "required": true,
        "source": "Thresholds",
        "quantity_kind": "absolute"
      }
    ],
    "thresholds": {
      "hall_sleep_timeout_hours": {
        "value": 0,
        "unit": "ratio",
        "source_ref": "EVD-DRAFT-DFMEA-TWS-HALL-001"
      },
      "min_required_hours": {
        "value": 24,
        "unit": "ratio",
        "source_ref": "EVD-DRAFT-DFMEA-TWS-HALL-001"
      }
    },
    "severity": "high",
    "rationale": "关联失效模式 FM-TWS-CASE-001",
    "recommendation": "按企业 DFMEA 评分表确认后发布",
    "evidence_level": "C",
    "owner": "DQE",
    "version": "0.1.0",
    "status": "draft",
    "notes": "关联失效模式 FM-TWS-CASE-001（web-research 草案）",
    "expression": "hall_sleep_timeout_hours >= min_required_hours",
    "tests": [
      {
        "name": "正常 80%（expr=hall_sleep_timeout_hours >= min_required)",
        "kind": "normal",
        "inputs": {
          "hall_sleep_timeout_hours": 0.8,
          "min_required_hours": 0.8
        },
        "expected_status": "PASS"
      },
      {
        "name": "边界（恰达阈值）",
        "kind": "boundary",
        "inputs": {
          "hall_sleep_timeout_hours": 1.0,
          "min_required_hours": 1.0
        },
        "expected_status": "PASS"
      },
      {
        "name": "异常输入（非数值）",
        "kind": "invalid",
        "inputs": {
          "hall_sleep_timeout_hours": "not-a-number",
          "min_required_hours": "not-a-number"
        },
        "expected_status": "ERROR"
      }
    ]
  },
