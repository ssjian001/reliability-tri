{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reliability.local/schemas/benchmark.schema.json",
  "title": "AI Benchmark Sample",
  "description": "AI电子硬件可靠性分析系统 - 基准集样本标注 Schema。配套文档：03_验证与验收规范 §4/§4.1。Precision/Recall/F1 与高风险漏报率以 expected_findings/not_expected 标注为唯一分母依据。 V1.1.1：增加双人独立 annotations（保留原始标注以计算一致性）。",
  "type": "object",
  "required": [
    "sample_id",
    "domain",
    "scenario_tag",
    "input_snapshot",
    "expected_findings",
    "not_expected",
    "reviewer",
    "label_status"
  ],
  "properties": {
    "sample_id": {
      "type": "string",
      "pattern": "^BENCH-[A-Z0-9]+-[0-9]{3}$",
      "description": "基准样本编号：BENCH-<域>-<序号>"
    },
    "domain": {
      "type": "string",
      "enum": [
        "derating",
        "pcb_pcba",
        "power",
        "esd_emi",
        "thermal",
        "dfmea",
        "fa",
        "dvpr",
        "unit_anomaly",
        "missing_data",
        "version_conflict",
        "expired_standard",
        "prompt_injection"
      ]
    },
    "scenario_tag": {
      "type": "string",
      "pattern": "^T(1[0-6]|[1-9])$",
      "description": "对应 03 §6 场景测试矩阵 ID"
    },
    "input_snapshot": {
      "type": "object",
      "required": [
        "ref",
        "checksum"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "description": "输入快照文件/参数集引用路径"
        },
        "checksum": {
          "type": "string",
          "description": "快照校验值，冻结依据"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "expected_findings": {
      "type": "array",
      "description": "标注答案：系统应产生的风险。空数组仅适用于「应拒答/无发现」类样本",
      "items": {
        "type": "object",
        "required": [
          "risk_ref",
          "severity",
          "match_hint",
          "rule_version_at_label"
        ],
        "properties": {
          "risk_ref": {
            "type": "string",
            "description": "关联规则 rule_id 或失效模式 mode_id"
          },
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "low",
              "info"
            ]
          },
          "match_hint": {
            "type": "string",
            "description": "风险识别要点（供评审比对措辞差异）"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rule_version_at_label": {
            "type": "string",
            "description": "标注时规则版本；规则改版后按此键判定匹配（复审 P2-7）"
          }
        }
      }
    },
    "not_expected": {
      "type": "array",
      "description": "明确不应产生的风险（误报计分依据）",
      "items": {
        "type": "object",
        "required": [
          "risk_ref"
        ],
        "properties": {
          "risk_ref": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "rationale": {
      "type": "string",
      "description": "专家判定理由"
    },
    "reviewer": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "description": "两位标注者 ID；必须与 annotations[].annotator_id 一一对应",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "adjudication": {
      "type": [
        "object",
        "null"
      ],
      "description": "分歧仲裁记录；无分歧为 null",
      "properties": {
        "arbitrator": {
          "type": "string"
        },
        "decision": {
          "type": "string"
        },
        "date": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "label_status": {
      "type": "string",
      "enum": [
        "agreed",
        "disputed",
        "resolved"
      ],
      "description": "agreed=双标一致；disputed=有分歧待仲裁；resolved=已仲裁冻结。仅 agreed/resolved 参与计分"
    },
    "benchmark_version": {
      "type": "string",
      "description": "基准集冻结版本号"
    },
    "annotations": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "description": "两位标注者独立提交的原始标注；不得用共识结果覆盖原始记录",
      "items": {
        "type": "object",
        "required": [
          "annotator_id",
          "expected_findings",
          "not_expected",
          "rationale"
        ],
        "properties": {
          "annotator_id": {
            "type": "string"
          },
          "expected_findings": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/finding"
            }
          },
          "not_expected": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/notExpected"
            }
          },
          "rationale": {
            "type": "string"
          },
          "annotated_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "label_status": {
            "const": "resolved"
          }
        }
      },
      "then": {
        "required": [
          "adjudication"
        ],
        "properties": {
          "adjudication": {
            "type": "object",
            "required": [
              "arbitrator",
              "decision",
              "date"
            ],
            "properties": {
              "arbitrator": {
                "type": "string",
                "minLength": 1
              },
              "decision": {
                "type": "string",
                "minLength": 1
              },
              "date": {
                "type": "string",
                "format": "date"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "finding": {
      "type": "object",
      "required": [
        "match_hint",
        "risk_ref",
        "rule_version_at_label",
        "severity"
      ],
      "properties": {
        "risk_ref": {
          "type": "string"
        },
        "severity": {
          "type": "string",
          "enum": [
            "critical",
            "high",
            "medium",
            "low",
            "info"
          ]
        },
        "match_hint": {
          "type": "string"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rule_version_at_label": {
          "type": "string",
          "description": "标注时规则版本；规则改版后按此键判定匹配"
        }
      },
      "additionalProperties": false
    },
    "notExpected": {
      "type": "object",
      "required": [
        "risk_ref"
      ],
      "properties": {
        "risk_ref": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}